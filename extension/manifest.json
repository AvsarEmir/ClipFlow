{
  "manifest_version": 3,
  "name": "ClipFlow • YouTube MP3 / MP4",
  "version": "1.0.0",
  "description": "Açık YouTube videosunu seçtiğiniz kalitede MP3 veya MP4 olarak bilgisayarınıza kaydedin.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background-v1.0.0.js",
    "type": "module"
  },
  "action": {
    "default_title": "ClipFlow ile indir",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
