{
    "manifest_version":  3,
    "name":  "ClipFlow • YouTube MP3 / MP4",
    "version":  "1.0.0",
    "description":  "Açık YouTube videosunu seçtiğiniz kalitede MP3 veya MP4 olarak bilgisayarınıza kaydedin.",
    "permissions":  [
                        "activeTab",
                        "nativeMessaging",
                        "storage"
                    ],
    "background":  {
                       "scripts":  [
                                       "background-v1.0.0.js"
                                   ],
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "ClipFlow ile indir",
                   "default_popup":  "popup.html"
               },
    "icons":  {
                  "16":  "icons/16.png",
                  "48":  "icons/48.png",
                  "128":  "icons/128.png"
              },
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "strict_min_version":  "140.0",
                                                    "id":  "diskora@diskora.local",
                                                    "data_collection_permissions":  {
                                                                                        "required":  [
                                                                                                         "browsingActivity",
                                                                                                         "websiteContent"
                                                                                                     ]
                                                                                    }
                                                }
                                  }
}